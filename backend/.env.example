# Copy to backend/.env and adjust. All settings are optional; defaults are shown.

# Secrets — set a strong value in any shared/deployed environment.
# If empty, a random secret is generated once and stored in backend/data/.jwt_secret
MEGAASSET_JWT_SECRET=
MEGAASSET_ACCESS_TOKEN_MINUTES=720

# Bootstrap administrator (created only if no admin exists). Change the password after first login.
MEGAASSET_BOOTSTRAP_ADMIN_EMAIL=admin@megaasset.local
MEGAASSET_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026
# Demo operator/engineer accounts for demonstrations (set false for real use)
MEGAASSET_CREATE_DEMO_STAFF=true

# Paths
# MEGAASSET_DATABASE_PATH=backend/data/megaasset.db
# MEGAASSET_RAW_DATA_DIR=data/raw
# MEGAASSET_UPLOADS_DIR=data/uploads

# Local AI
MEGAASSET_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MEGAASSET_EMBEDDING_BATCH_SIZE=32
MEGAASSET_ENABLE_OCR=true
MEGAASSET_INGEST_WORKERS=3
MEGAASSET_AUTO_INGEST_ON_STARTUP=true
# Optional local LLM via Ollama (leave empty for extractive, quote-only answers)
MEGAASSET_OLLAMA_URL=http://127.0.0.1:11434
MEGAASSET_OLLAMA_MODEL=

MEGAASSET_MAX_UPLOAD_MB=50
MEGAASSET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
